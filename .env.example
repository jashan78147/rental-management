# Copy to .env.local for development, and add the same keys in the Vercel
# project settings for the deployed app. Every one of these is optional: the app
# runs without them, degrading each feature to a deterministic fallback.

# --- AI recommendations -----------------------------------------------------
# Without this the kit builder falls back to keyword matching, the cart panel
# falls back to co-rental history, and the desk brief falls back to rules.
ANTHROPIC_API_KEY=

# --- Database ---------------------------------------------------------------
# Without these the app runs on the in-memory seeded dataset. See README for the
# one-time schema setup.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments ---------------------------------------------------------------
# Without this, "take payment" records the payment against the invoice with a
# test reference instead of charging a card.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
